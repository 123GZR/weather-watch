root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 99
ij_kotlin_packages_to_use_import_on_demand = 0

[*.{yml,yaml,toml}]
indent_size = 2

[*.{xml,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
